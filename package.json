{
  "name": "routix-delivery-platform",
  "version": "1.0.0",
  "description": "A comprehensive delivery management platform connecting customers, drivers, and administrators",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd Frontend && npm run dev",
    "dev:backend": "cd Backend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd Frontend && npm run build",
    "start": "cd Backend && npm start",
    "install:all": "npm install && cd Frontend && npm install && cd ../Backend && npm install",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd Frontend && npm test",
    "test:backend": "cd Backend && npm test",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd Frontend && npm run lint",
    "lint:backend": "cd Backend && npm run lint"
  },
  "keywords": [
    "delivery",
    "management",
    "platform",
    "react",
    "nodejs",
    "mongodb",
    "socketio",
    "real-time",
    "tracking",
    "logistics"
  ],
  "author": "Routix Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/routix-delivery-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/routix-delivery-platform/issues"
  },
  "homepage": "https://github.com/yourusername/routix-delivery-platform#readme",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "Frontend",
    "Backend"
  ]
}